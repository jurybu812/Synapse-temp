{
  "name": "synapse-app",
  "private": true,
  "version": "0.1.0",
  "description": "Synapse — 可扩展的桌面编程智能体",
  "author": "Synapse Contributors",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "postinstall": "electron-builder install-app-deps",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "tsc -p tsconfig.electron.json",
    "test:bpc": "npm run electron:build && electron scripts/bpc-generation.integration.cjs",
    "test:bpc-scheduler": "node scripts/bpc-scheduler.integration.mjs",
    "test:file-search": "npm run electron:build && electron scripts/file-search.integration.cjs",
    "test:file-access": "npm run electron:build && electron scripts/file-access.integration.cjs",
    "test:web-fetch": "npm run electron:build && electron scripts/web-fetch.integration.cjs",
    "test:web-search": "npm run electron:build && electron scripts/web-search.integration.cjs",
    "test:memory-scope": "npm run electron:build && electron scripts/memory-scope.integration.cjs",
    "test:sandbox-javascript": "npm run electron:build && electron scripts/sandbox-javascript.integration.cjs",
    "test:diff-review": "node scripts/diff-review.integration.cjs",
    "test:diff-history": "node scripts/diff-history.integration.cjs",
    "test:provider-runtime": "npm run electron:build && electron scripts/provider-runtime.integration.cjs",
    "test:ai-client-retry": "node scripts/ai-client-retry.integration.cjs",
    "test:message-metadata": "npm run electron:build && electron scripts/message-metadata-persistence.integration.cjs",
    "test:tool-task-recovery": "npm run electron:build && electron scripts/tool-task-recovery.integration.cjs",
    "test:message-window": "node scripts/message-window.integration.cjs",
    "test:queue-interrupt": "node scripts/queue-interrupt.integration.cjs",
    "test:token-projection": "node scripts/token-projection.integration.cjs",
    "test:auto-continue": "node scripts/auto-continue.integration.cjs",
    "test:editor-save-conflict": "node scripts/editor-save-conflict.integration.cjs",
    "test:html-viewer-safety": "node scripts/html-viewer-safety.integration.cjs",
    "test:file-viewers": "node scripts/file-viewers.integration.cjs",
    "test:runtime-shutdown": "node scripts/runtime-shutdown.static.cjs",
    "test:agent-session-checkpoint": "node scripts/agent-session-checkpoint.integration.cjs",
    "test:provider-auth-state": "npm run electron:build && electron scripts/provider-auth-state.integration.cjs",
    "test:windsurf-local-import": "npm run electron:build && electron scripts/windsurf-local-import.integration.cjs",
    "test:openai-codex-live": "npm run electron:build && electron scripts/openai-codex-live.integration.cjs",
    "test:windsurf-live": "npm run electron:build && electron scripts/windsurf-live.integration.cjs",
    "test:windsurf-tool-stream": "node scripts/windsurf-tool-stream.integration.cjs",
    "test:tool-call-arguments": "node scripts/tool-call-arguments.integration.cjs",
    "test:mcp-ipc-security": "node scripts/mcp-ipc-security.static.cjs",
    "test:secret-boundary": "node scripts/secret-boundary.static.cjs",
    "test:settings-transfer": "node scripts/settings-transfer.integration.cjs",
    "test:model-capabilities": "node scripts/model-capabilities.integration.cjs",
    "license:generate": "node scripts/generate-third-party-notices.cjs",
    "submission:export": "node scripts/export-anonymous-submission.cjs",
    "submission:audit": "node scripts/audit-anonymous-submission.cjs",
    "electron:deps": "electron-builder install-app-deps",
    "electron:dev": "npm run electron:build && concurrently -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron . --remote-debugging-port=9333\"",
    "icon:generate": "electron scripts/generate-app-icon.cjs",
    "electron:pack": "npm run clean:pack && npm run license:generate && npm run icon:generate && npm run build && npm run electron:build && electron-builder",
    "electron:pack:dir": "npm run clean:pack && npm run license:generate && npm run icon:generate && npm run build && npm run electron:build && electron-builder --dir",
    "clean": "rimraf dist dist-electron",
    "clean:pack": "rimraf dist dist-electron release"
  },
  "build": {
    "appId": "com.synapse.app",
    "productName": "Synapse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "better-sqlite3": "^12.9.0",
    "gpt-tokenizer": "^3.4.0",
    "katex": "^0.16.40",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.13.0",
    "opencode-windsurf-auth": "^0.3.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^4.7.5",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
